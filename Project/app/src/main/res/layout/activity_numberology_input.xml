<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter Baby Date of Birth"
            android:textColor="@color/teal_700"
            android:textSize="26sp"
            android:gravity="center"
            android:layout_marginTop="20dp" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:src="@drawable/astrology2"
            android:scaleType="centerCrop"
            android:layout_gravity="center"
            android:layout_margin="20dp"
            android:background="@drawable/circle_bg"
            android:clipToOutline="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date Of Birth"
            android:textColor="@color/colorTextPrimary"
            android:textSize="20sp"
            android:layout_gravity="center"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="5dp"
                app:endIconMode="dropdown_menu"
                app:hintTextColor="@color/colorTextSecondary">

                <AutoCompleteTextView
                    android:id="@+id/dayDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Day"
                    android:padding="15dp"
                    android:background="@drawable/input_field"
                    android:focusable="false"
                    android:clickable="true"
                    android:textColorHint="@color/colorTextSecondary"
                    android:textColor="@color/colorTextPrimary"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="5dp"
                app:endIconMode="dropdown_menu"
                app:hintTextColor="@color/colorTextSecondary">

                <AutoCompleteTextView
                    android:id="@+id/monthDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Month"
                    android:textColorHint="@color/colorTextSecondary"
                    android:background="@drawable/input_field"
                    android:focusable="false"
                    android:clickable="true"
                    android:padding="15dp"
                    android:textColor="@color/colorTextPrimary"/>
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="5dp"
                app:endIconMode="dropdown_menu"
                app:hintTextColor="@color/colorTextSecondary">

                <AutoCompleteTextView
                    android:id="@+id/yearDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Year"
                    android:textColorHint="@color/colorTextSecondary"
                    android:background="@drawable/input_field"
                    android:focusable="false"
                    android:padding="15dp"
                    android:clickable="true"
                    android:textColor="@color/colorTextPrimary"/>
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/generateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/button"
            android:padding="15dp"
            android:text="Generate Names"
            android:textSize="16sp"
            android:textColor="@android:color/white" />



    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>