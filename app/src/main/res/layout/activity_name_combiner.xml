<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground"
        android:padding="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/numberology_page_border"
            android:padding="40dp">

            <!-- Image -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/parentImage"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:layout_marginBottom="20dp"
                app:shapeAppearanceOverlay="@style/CircleImage"
                android:src="@drawable/bg2"/>

            <!-- Title -->
            <TextView
                android:id="@+id/parentCombinerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parent Name Combiner"
                android:textColor="@color/teal_700"
                android:textSize="34sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_marginBottom="10dp" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/parentCombinerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Merge parent names to generate a unique baby name"
                android:textColor="@color/colorTextSecondary"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- Father Name Input -->
            <EditText
                android:id="@+id/fatherNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Father's Name"
                android:textColorHint="@color/colorTextSecondary"
                android:padding="15dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/input_field"
                android:textColor="@color/colorTextPrimary"/>

            <EditText
                android:id="@+id/motherNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mother's Name"
                android:padding="15dp"
                android:textColorHint="@color/colorTextSecondary"
                android:layout_marginBottom="30dp"
                android:background="@drawable/input_field"
                android:textColor="@color/colorTextPrimary"/>

            <!-- Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/combineButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/button"
                android:padding="15dp"
                android:text="Generate Names"
                android:textSize="16sp"
                android:textColor="@android:color/white" />


        </LinearLayout>

    </RelativeLayout>

</ScrollView>
